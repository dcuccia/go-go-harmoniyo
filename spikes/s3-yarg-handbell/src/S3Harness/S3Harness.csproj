<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>S3Harness</RootNamespace>
    <NoWarn>$(NoWarn);CS8632;CS8625;CS8604;CS8714;CS8621</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="$(YargCoreProject)" />
    <!-- The fork's Unity-free HGP code (LGPL-3.0-or-later in the fork); compiled from the checkout, not vendored -->
    <Compile Include="$(HgpCoreDir)\*.cs" Link="HgpCore\%(Filename)%(Extension)" />
  </ItemGroup>

</Project>
