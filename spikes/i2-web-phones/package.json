{
  "name": "i2-web-phones",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "description": "Integration I2: phones (S1 HGP host) driving the S4 web host with S5 charts, multi-ringer (spike code).",
  "license": "MIT",
  "scripts": {
    "charts": "node scripts/build-charts.mjs",
    "predev": "npm run charts",
    "dev": "vite",
    "prebuild": "npm run charts",
    "build": "tsc --noEmit && vite build",
    "start": "node scripts/start.mjs",
    "pree2e": "npm run build",
    "e2e": "node scripts/e2e.mjs",
    "pree2e:seating": "npm run build",
    "e2e:seating": "node scripts/seating-e2e.mjs",
    "preaudio-check": "npm run charts",
    "audio-check": "node scripts/backing-render-check.mjs",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "three": "^0.170.0"
  },
  "devDependencies": {
    "@types/three": "^0.170.0",
    "playwright-core": "^1.64.1",
    "typescript": "^5.9.3",
    "vite": "^5.4.21",
    "vitest": "^2.1.9"
  },
  "engines": {
    "node": ">=22"
  }
}
