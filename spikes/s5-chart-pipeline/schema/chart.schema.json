{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/dcuccia/go-go-harmoniyo/spikes/s5-chart-pipeline/schema/chart.schema.json",
  "title": "Go Go HarmoniYo chart v0.3 (S5 proposal)",
  "description": "Engine-neutral handbell chart: one file per song, containing parts for several ringer counts and difficulty tiers. Times are given both in ticks (exact, for editing/export) and seconds (pre-computed from the tempo map, for playback). Unknown properties must be ignored by readers.",
  "type": "object",
  "required": ["format", "formatVersion", "song", "timing", "bells", "parts"],
  "properties": {
    "format": {
      "enum": ["go-go-harmoniyo.chart", "handbell-hero.chart"],
      "description": "Writers emit \"go-go-harmoniyo.chart\". Readers also accept \"handbell-hero.chart\", the id used before the rename (ADR-0009)."
    },
    "formatVersion": { "type": "string", "pattern": "^0\\.\\d+\\.\\d+$" },
    "generator": {
      "type": "object",
      "properties": { "name": { "type": "string" }, "version": { "type": "string" } }
    },
    "song": {
      "type": "object",
      "required": ["id", "title", "license", "source"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$" },
        "title": { "type": "string", "minLength": 1 },
        "composer": { "type": "string" },
        "year": { "type": ["integer", "null"] },
        "key": { "type": ["string", "null"] },
        "license": {
          "type": "object",
          "required": ["id"],
          "description": "License of the source file this chart was derived from (SPDX id or LicenseRef-*).",
          "properties": { "id": { "type": "string" }, "url": { "type": "string" }, "text": { "type": "string" } }
        },
        "source": {
          "type": "object",
          "required": ["kind"],
          "properties": {
            "kind": { "enum": ["self-encoded", "mutopia", "cpdl", "imslp", "other"] },
            "file": { "type": "string" },
            "url": { "type": "string" },
            "fileUrl": { "type": "string" },
            "attribution": { "type": "string" },
            "notes": { "type": "string" }
          }
        }
      }
    },
    "timing": {
      "type": "object",
      "required": ["resolution", "tempos", "timeSignatures", "measures", "endTick", "durationSec"],
      "properties": {
        "resolution": { "type": "integer", "minimum": 1, "description": "Ticks per quarter note." },
        "tempos": {
          "type": "array", "minItems": 1,
          "items": { "type": "object", "required": ["tick", "time", "bpm"], "properties": { "tick": { "$ref": "#/$defs/tick" }, "time": { "$ref": "#/$defs/seconds" }, "bpm": { "type": "number", "exclusiveMinimum": 0, "description": "Quarter notes per minute." } } }
        },
        "timeSignatures": {
          "type": "array", "minItems": 1,
          "items": { "type": "object", "required": ["tick", "numerator", "denominator"], "properties": { "tick": { "$ref": "#/$defs/tick" }, "numerator": { "type": "integer", "minimum": 1 }, "denominator": { "enum": [1, 2, 4, 8, 16, 32] } } }
        },
        "measures": {
          "type": "array",
          "description": "Bar lines for the highway; the first may be a pickup (anacrusis).",
          "items": { "type": "object", "required": ["number", "tick", "time"], "properties": { "number": { "type": "integer", "minimum": 1 }, "tick": { "$ref": "#/$defs/tick" }, "time": { "$ref": "#/$defs/seconds" }, "pickup": { "type": "boolean" } } }
        },
        "endTick": { "$ref": "#/$defs/tick" },
        "durationSec": { "$ref": "#/$defs/seconds" }
      }
    },
    "bells": {
      "type": "array",
      "description": "Every bell used by any part, low to high. Written pitch, scientific notation with sharps (handbells sound an octave higher than written).",
      "items": { "type": "object", "required": ["id", "midi"], "properties": { "id": { "$ref": "#/$defs/bellId" }, "midi": { "type": "integer", "minimum": 0, "maximum": 127 }, "natural": { "type": "boolean" } } }
    },
    "form": {
      "type": "object",
      "description": "Optional (format 0.3+). How the song is laid out: sections in time order. Charts without it are the song played once.",
      "required": ["id", "sections"],
      "properties": {
        "id": { "type": "string", "description": "full: intro, verses that develop, optional interlude + key change, coda. short: the song once." },
        "sections": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["index", "kind", "tick", "endTick", "time", "endTime"],
            "properties": {
              "index": { "type": "integer", "minimum": 0 },
              "kind": { "enum": ["intro", "verse", "interlude", "coda"] },
              "label": { "type": "string" },
              "verse": { "type": "integer", "minimum": 1 },
              "tick": { "$ref": "#/$defs/tick" },
              "endTick": { "$ref": "#/$defs/tick" },
              "time": { "$ref": "#/$defs/seconds" },
              "endTime": { "$ref": "#/$defs/seconds" },
              "transpose": { "type": "integer", "description": "Semitones relative to the song's written key (key change)." },
              "key": { "$ref": "#/$defs/pitchClass", "description": "Tonic pitch class in this section." },
              "development": { "type": "string", "description": "Arrangement stage, e.g. intro, light, full, descant, quiet, finale, interlude, coda, once." },
              "energy": { "type": "number", "minimum": 0, "maximum": 1, "description": "Backing intensity hint (0 = sparse, 1 = full)." }
            }
          }
        }
      }
    },
    "handbellSet": {
      "type": "object",
      "description": "Smallest standard handbell set the bells fit, and the transposition needed (informational).",
      "properties": { "set": { "type": ["string", "null"] }, "label": { "type": "string" }, "transposeSemitones": { "type": "integer" }, "span": { "type": "integer" } }
    },
    "harmony": {
      "type": "object",
      "description": "Optional (format 0.2+). Chord timeline and beat grid for a generated backing track. Readers that do not know it ignore it; charts without it play with no backing.",
      "required": ["source", "chords", "beats"],
      "properties": {
        "source": { "enum": ["lead-sheet", "inferred"], "description": "lead-sheet: chord symbols written in the source file; inferred: chords estimated from the notes, one per strong-beat segment." },
        "style": { "type": "string", "description": "Backing style preset, e.g. sleigh-ride, march, waltz, gentle. Unknown styles fall back to the reader's default." },
        "chords": {
          "type": "array",
          "description": "Chord symbols in time order; a chord lasts until the next one (gaps = no chord).",
          "items": {
            "type": "object",
            "required": ["tick", "time", "dur", "symbol", "root", "tones"],
            "properties": {
              "tick": { "$ref": "#/$defs/tick" },
              "time": { "$ref": "#/$defs/seconds" },
              "dur": { "type": "integer", "minimum": 1 },
              "durSec": { "$ref": "#/$defs/seconds" },
              "symbol": { "type": "string", "minLength": 1 },
              "root": { "$ref": "#/$defs/pitchClass" },
              "bass": { "$ref": "#/$defs/pitchClass" },
              "tones": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/pitchClass" }, "description": "Pitch classes, root first (0 = C)." }
            }
          }
        },
        "beats": {
          "type": "array",
          "description": "Every beat of the song (compound meters: dotted-quarter beats), with times from the tempo map.",
          "items": {
            "type": "object",
            "required": ["tick", "time", "bar", "beat"],
            "properties": {
              "tick": { "$ref": "#/$defs/tick" },
              "time": { "$ref": "#/$defs/seconds" },
              "bar": { "type": "integer", "minimum": 1, "description": "Measure number (matches timing.measures)." },
              "beat": { "type": "integer", "minimum": 0, "description": "Beat position in the bar, 0 = downbeat (pickup beats keep their bar position)." },
              "div": { "enum": [2, 3], "description": "Subdivisions per beat: 2 simple, 3 compound." },
              "strong": { "type": "boolean" },
              "chord": { "type": ["integer", "null"], "minimum": 0, "description": "Index into chords of the chord sounding on this beat." },
              "section": { "type": "integer", "minimum": 0, "description": "Format 0.3+: index into form.sections (lets the backing follow the form when times are rescaled)." }
            }
          }
        }
      }
    },
    "parts": {
      "type": "array", "minItems": 1,
      "items": { "$ref": "#/$defs/part" }
    }
  },
  "$defs": {
    "tick": { "type": "integer", "minimum": 0 },
    "seconds": { "type": "number", "minimum": 0 },
    "pitchClass": { "type": "integer", "minimum": 0, "maximum": 11 },
    "bellId": { "type": "string", "pattern": "^[A-G]#?-?\\d$" },
    "part": {
      "type": "object",
      "required": ["difficulty", "ringerCount", "ringers", "notes"],
      "properties": {
        "difficulty": { "enum": ["super-easy", "easy", "medium", "hard", "expert"], "description": "super-easy (0.3+): downbeats/long notes of the tune, generous spacing, at most 3 bells per ringer; the host plays the rest (guide)." },
        "arrangement": { "enum": ["balanced", "chord-split", "by-range"], "description": "Format 0.3+. balanced: one musical role and pitch region per ringer, loads evened out; chord-split: the chord spread over up to 3 ringers, one tone each; by-range: bells cut into ranges by load (0.1/0.2 behaviour, the meaning when absent)." },
        "ringerCount": { "type": "integer", "minimum": 1 },
        "profile": { "type": "string", "description": "Controller/technique profile the assignment was optimized for (e.g. handbell, phone-4zone)." },
        "ringers": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["index", "bells"],
            "properties": {
              "index": { "type": "integer", "minimum": 0 },
              "label": { "type": "string" },
              "role": { "enum": ["bass", "harmony", "chord", "melody", "descant"], "description": "Format 0.3+: the musical role of this ringer's bells." },
              "name": { "type": "string", "description": "Format 0.3+: display name, e.g. Bass, Low melody, Chord middle." },
              "bells": { "type": "array", "items": { "$ref": "#/$defs/bellId" }, "description": "Low to high; lane order on this ringer's highway." },
              "stats": { "type": "object" }
            }
          }
        },
        "notes": {
          "type": "array",
          "description": "Strikes sorted by tick. A note is one ring of one bell.",
          "items": {
            "type": "object",
            "required": ["tick", "time", "bell", "ringer"],
            "properties": {
              "tick": { "$ref": "#/$defs/tick" },
              "time": { "$ref": "#/$defs/seconds" },
              "dur": { "type": "integer", "minimum": 0, "description": "Written duration in ticks (let-vibrate length / damp point)." },
              "durSec": { "$ref": "#/$defs/seconds" },
              "bell": { "$ref": "#/$defs/bellId" },
              "ringer": { "type": "integer", "minimum": 0 },
              "role": { "enum": ["melody", "bass", "inner", "descant"] },
              "technique": { "type": "string", "description": "Reserved: ring (default), damp, LV, shake, martellato, ... (HGP gesture vocabulary)." }
            }
          }
        },
        "guide": {
          "type": "array",
          "description": "Format 0.3+, optional: notes the host plays softly (no ringer), e.g. the rest of the tune in super-easy or a descant no ringer has.",
          "items": {
            "type": "object",
            "required": ["tick", "time", "bell"],
            "properties": {
              "tick": { "$ref": "#/$defs/tick" },
              "time": { "$ref": "#/$defs/seconds" },
              "dur": { "type": "integer", "minimum": 0 },
              "durSec": { "$ref": "#/$defs/seconds" },
              "bell": { "$ref": "#/$defs/bellId" },
              "role": { "enum": ["melody", "bass", "inner", "descant"] }
            }
          }
        },
        "metrics": { "type": "object" }
      }
    }
  }
}
