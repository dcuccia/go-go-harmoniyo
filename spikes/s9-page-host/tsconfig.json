{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "strict": true,
    "resolveJsonModule": true,
    "noEmit": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "allowImportingTsExtensions": true,
    "allowJs": true,
    "checkJs": false,
    "esModuleInterop": true,
    "types": ["node", "vite/client"],
    "paths": {
      "three": ["../i2-web-phones/node_modules/@types/three/index.d.ts"],
      "three/*": ["../i2-web-phones/node_modules/@types/three/*"]
    }
  },
  "include": ["src", "server", "test"]
}
