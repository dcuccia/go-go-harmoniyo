{
  "name": "s9-page-host",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "description": "Spike S9: the HGP host in the TV/tablet page, phones over WebRTC data channels via a tiny signalling service; Android TV / iPad app shells (throwaway spike code).",
  "license": "MIT",
  "scripts": {
    "build": "node scripts/build.mjs",
    "dev": "tsx server/dev-server.ts",
